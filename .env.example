# Google Gemini API Key (Server-side only — NEVER prefix with VITE_ or expose in frontend)
# On Vercel: Settings -> Environment Variables -> GEMINI_API_KEY
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL="gemini-2.5-flash"

# Priority 2 — OpenRouter API (Automatic failover when Gemini hits quota/429/error)
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openrouter/free"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# Priority 3 — OpenAI Responses API (Automatic failover after OpenRouter)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_PASSCODE: Passcode required to authenticate into the /admin panel APIs.
# If left empty, the first administrator can securely initialize one via /admin.
ADMIN_PASSCODE=""

# ADMIN_SESSION_SECRET: Optional 32+ char secret used to sign Admin HMAC session tokens.
ADMIN_SESSION_SECRET=""
