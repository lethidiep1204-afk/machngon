# OPENAI_API_KEY: Optional. Enables OpenAI Responses API (/v1/responses) with previous_response_id memory in Thinking Lab.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"

# GEMINI_API_KEY: Required for Gemini AI API calls when OpenAI key is not configured.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_PASSCODE: Passcode required to authenticate into the /admin panel APIs.
# If left empty, the first administrator can securely initialize one via /admin.
ADMIN_PASSCODE=""

# ADMIN_SESSION_SECRET: Optional 32+ char secret used to sign Admin HMAC session tokens.
ADMIN_SESSION_SECRET=""

